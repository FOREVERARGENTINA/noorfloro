# Firebase (client - public keys)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Service account for server-side operations (migration, admin scripts).
# You can either set GOOGLE_APPLICATION_CREDENTIALS to a file path with the JSON key,
# or paste the service account JSON as base64 into the variable below (recommended for CI):
# Example (bash): export FIREBASE_SERVICE_ACCOUNT_BASE64=$(base64 serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Optional: alternate way to pass the service account as JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON={...}

# Notes:
# - Do NOT commit real secret values to the repository. Keep this file in source control only as an example.
# - Use a real `.env.local` (gitignored) with the above values populated locally.
