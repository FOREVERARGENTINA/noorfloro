# Frontend Configuration
NEXT_PUBLIC_SITE_URL=https://noorfloro.web.app  # Actualiza si usás dominio personalizado

# Firebase Configuration (Frontend / Public keys)
# Get these from Firebase Console -> Project settings -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# (Deprecated) Supabase variables are removed from the project. If you rely on Supabase, re-add NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY here.

# Admin Configuration
NEXT_PUBLIC_ADMIN_EMAIL=admin@tutienda.com

# Mercado Pago
NEXT_PUBLIC_MP_PUBLIC_KEY=your_mp_public_key_here
NEXT_PUBLIC_MP_SANDBOX=true

# Server-side / Functions (set these as secrets in CI or via `firebase functions:config:set`)
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-of-service-account.json
# MP_ACCESS_TOKEN=your_mp_access_token_here
# WEBHOOK_URL=https://us-central1-your-project.cloudfunctions.net/webhookMercadoPago  # or your worker URL

# Optional: Resend for emails
# RESEND_API_KEY=your_resend_api_key
